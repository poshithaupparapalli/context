# Copy this file to `.env` (server/.env) and fill in ONE provider key.
# `.env` is git-ignored. Never put API keys in the extension.

# --- Provider (pick one) -----------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: force a provider ("anthropic" | "openai"). By default the provider
# is inferred from whichever key is set.
# CONTEXT_PROVIDER=

# Optional: point the OpenAI provider at any OpenAI-compatible endpoint
# (OpenRouter, Groq, a local Ollama at http://localhost:11434/v1, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Models --------------------------------------------------------------
# The fast model writes the small card; the deep model writes the exploration
# and answers follow-ups. Defaults depend on the provider.
# CONTEXT_FAST_MODEL=
# CONTEXT_DEEP_MODEL=

# --- Server ----------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# CONTEXT_TIMEOUT_MS=45000
